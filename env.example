# Токен бота, отриманий у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Через кому — Telegram user id тих, кому бот дозволить керувати задачами.
# Свій id можна дізнатись у бота @userinfobot
ALLOWED_USER_IDS=

# Telegram chat id, куди слати алерти від watchdog і статуси
# деплой/багфікс-агентів. Можна той самий чат, що й команда.
TELEGRAM_ALERT_CHAT_ID=

# Потрібні лише для того, щоб bot.py (не агенти в GitHub Actions — там
# токен вже є в secrets.GITHUB_TOKEN) міг сам відкривати GitHub issue
# при помилках у проді (крок 3, agents/common.create_github_issue).
# GITHUB_TOKEN — personal access token з правом Issues: write на репо.
# GITHUB_REPOSITORY — у форматі "org-or-user/repo-name".
# Якщо не заповнити — бот просто пише помилку в errors.log і шле
# алерт у Telegram замість issue, без падіння.
GITHUB_TOKEN=
GITHUB_REPOSITORY=

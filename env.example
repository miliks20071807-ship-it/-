# Токен основного бота-диспетчера, отриманий у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Опційно: окремі боти під конкретних агентів — своя ідентичність у
# Telegram, відмінна від диспетчера. Якщо лишити порожнім, сповіщення
# (і кнопки "Затвердити"/"Відхилити" під ними) просто йдуть через
# основного бота — нічого не ламається.
TELEGRAM_BUGFIX_BOT_TOKEN=
TELEGRAM_DEPLOY_BOT_TOKEN=
TELEGRAM_DESIGNER_BOT_TOKEN=
TELEGRAM_STANDUP_BOT_TOKEN=
TELEGRAM_IDEAS_BOT_TOKEN=

# Час і дні щоденного авто-стендапу (локальний час хоста бота).
STANDUP_TIME=09:30
STANDUP_DAYS=mon,tue,wed,thu,fri

# День/час/часовий пояс щотижневої розсилки ідей (3 продуктові +
# 3 контентні). day: mon/tue/.../sun.
IDEAS_DAY=mon
IDEAS_TIME=10:00
IDEAS_TIMEZONE=Europe/Kyiv

# Ключ Anthropic API (https://console.anthropic.com) — використовується
# завжди для багфікс-агента (там ціна помилки найвища) і як фолбек для
# дизайн-/ідея-/пітч-агента, якщо GROQ_API_KEY/GEMINI_API_KEY нижче не
# задані чи їхній безкоштовний тариф тимчасово недоступний.
ANTHROPIC_API_KEY=

# Опційно: безкоштовні тарифи для дизайн-/ідея-/пітч-агента (щоб не
# платити за Claude на кожен мокап/ідею/пітч). Якщо не заповнити —
# агенти просто завжди йдуть через Claude (ANTHROPIC_API_KEY вище),
# нічого не ламається.
#   GROQ_API_KEY — https://console.groq.com/keys (email, без картки;
#     дизайн-агент, модель moonshotai/kimi-k2-instruct)
#   GEMINI_API_KEY — https://aistudio.google.com/app/apikey (без картки;
#     ідея- і пітч-агент, модель gemini-3.6-flash)
GROQ_API_KEY=
GEMINI_API_KEY=

# Скільки викликів Claude API (не Groq/Gemini — ті безкоштовні) дозволено
# на добу, сумарно на всі агенти. Понад ліміт: автоматичні (не по
# команді людини) виклики — деплой-крон, багфікс-агент, щотижнева
# розсилка ідей — самі пропускають прогін і шлють одне попередження в
# Telegram замість того, щоб мовчки накопичувати рахунок. Ручні команди
# (/дизайн, /ідея_*, вільний чат) не гейтяться цим лімітом.
ANTHROPIC_DAILY_CALL_LIMIT=200

# Через кому — Telegram user id тих, кому бот дозволить керувати задачами.
# Свій id можна дізнатись у бота @userinfobot
ALLOWED_USER_IDS=

# Telegram chat id, куди слати алерти від watchdog і статуси
# деплой/багфікс-агентів. Можна той самий чат, що й команда.
TELEGRAM_ALERT_CHAT_ID=

# Потрібні лише для bot.py (не агенти в GitHub Actions — там токен вже
# є в secrets.GITHUB_TOKEN), щоб людина могла керувати PR і бачити
# статус агентів ПРЯМО з Telegram, не заходячи на GitHub:
#   - відкривати issue при помилках у проді (agents.common.create_github_issue)
#   - мерджити/закривати PR по кнопці "Затвердити"/"Відхилити" (merge_pr/close_pr)
#   - показувати /статус_агентів (get_last_workflow_run, list_open_agent_prs)
# GITHUB_TOKEN — personal access token з правами:
#   Issues: write, Pull requests: write, Actions: read+write (fine-grained PAT
#   — write потрібен для тега @деплой, який запускає workflow позачергово)
#   або просто "repo" для класичного PAT.
# GITHUB_REPOSITORY — у форматі "org-or-user/repo-name".
# Якщо не заповнити — бот деградує грейсфулно: помилки йдуть лише в
# errors.log/Telegram-текстом, кнопки підтвердження повертають помилку
# замість мерджу, /статус_агентів пише "даних немає".
GITHUB_TOKEN=
GITHUB_REPOSITORY=
